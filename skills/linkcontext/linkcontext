from pathlib import Path
import sys

try:
    from linkcontext_client.cli import main
except ModuleNotFoundError:
    for candidate in (
        Path(__file__).resolve().parents[2] / "src",
        Path("/home/ubuntu/code/pocketcontext/linkcontext/src"),
    ):
        if (candidate / "linkcontext_client").is_dir():
            sys.path.insert(0, str(candidate))
            break
    from linkcontext_client.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
